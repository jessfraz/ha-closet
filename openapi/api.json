            "type": "string"
          },
          "temperature_unit": {
            "type": "string"
          },
          "window_end": {
            "format": "date-time",
            "type": "string"
          },
          "window_start": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "coverage",
          "entries",
          "forecast_type",
          "retrieved_at",
          "temperature_unit",
          "window_end",
          "window_start"
        ],
        "type": "object"
      },
      "WeatherMode": {
        "enum": [
          "required",
          "ignored"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "description": "JSON-authoritative inventory validation and atomic sync, read-only catalog browsing, and optional on-demand outfit suggestions. Native owner or trusted HA administrator mutations require explicit idempotency/precondition headers. GET never generates model work.",
    "title": "Closet API",
    "version": "0.1.2"
  },
  "openapi": "3.0.3",
