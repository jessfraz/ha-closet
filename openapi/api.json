          },
          "stale_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "type": "array"
          },
          "weather": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WeatherContext"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "expires_at",
          "freshness",
          "generated_at",
          "generation_id",
          "inputs",
          "stale_reasons",
          "suggestions"
        ],
        "type": "object"
      },
      "ValidationReport": {
        "properties": {
          "count": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "source_hash": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
