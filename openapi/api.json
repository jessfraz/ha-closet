        "type": "object"
      },
      "TodayRequest": {
        "additionalProperties": false,
        "properties": {
          "occasion": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Occasion"
              }
            ],
            "default": "everyday"
          },
          "ownership_scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OwnershipScope"
              }
