            "default": "all_inventory"
          },
          "weather_mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WeatherMode"
              }
            ],
            "default": "required"
          }
        },
        "type": "object"
      },
      "TodayResponse": {
        "properties": {
          "date": {
            "type": "string"
          },
          "generation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Generation"
              }
            ],
            "nullable": true
          },
          "result": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TodayResult"
              }
            ],
            "nullable": true
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "timezone"
        ],
        "type": "object"
      },
      "TodayResult": {
        "properties": {
          "expires_at": {
            "format": "date-time",
