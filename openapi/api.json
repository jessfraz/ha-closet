    "/v1/inventory/sync": {
      "post": {
        "operationId": "inventory_sync",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncReport"
                }
              }
            },
            "description": "successful operation",
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              },
              "etag": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Preview or atomically reconcile a complete authoritative JSON catalog.",
        "tags": [
          "inventory"
        ]
      }
    },
    "/v1/inventory/validate": {
      "post": {
        "operationId": "inventory_validate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/CatalogItem"
                },
                "title": "Array_of_CatalogItem",
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReport"
                }
              }
            },
            "description": "successful operation",
            "headers": {
              "cache-control": {
                "required": true,
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Use the same validator as the offline CLI without changing any state.",
        "tags": [
          "inventory"
        ]
      }
    },
    "/v1/items": {
      "get": {
        "operationId": "items_list",
        "parameters": [
          {
            "in": "query",
            "name": "brand",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "nullable": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "confirmed_only",
            "schema": {
              "nullable": true,
              "type": "boolean"
            }
